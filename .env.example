# Sentry DSN used to initialize @sentry/react-native. leave unset (or empty)
# to run with error tracking disabled — the app starts up fine either way.
EXPO_PUBLIC_SENTRY_DSN=

# Amplitude project API key used to initialize
# @amplitude/analytics-react-native. leave unset (or empty) to run with
# product-event tracking disabled — the app starts up fine either way. see
# docs/conventions/product-analytics.md.
EXPO_PUBLIC_AMPLITUDE_API_KEY=

# overrides the app version shown to users for a preview/internal build.
# read by app.config.ts. leave unset for local development.
# PREVIEW_VERSION_NAME=

# commit hash injected into extra.commitHash. set by CI; app.config.ts falls
# back to `git rev-parse HEAD` when this is unset, so local development does
# not need to set it.
# GITHUB_SHA=

# CI run number, the source app.config.ts derives ios.buildNumber and
# android.versionCode from. set by CI; app.config.ts falls back to 1 when
# this is unset, so local development does not need to set it.
# GITHUB_RUN_NUMBER=
