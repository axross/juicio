# two preview pipelines, one platform block each: :android drives
# .github/workflows/android-preview.yaml against the `android/` project
# `expo prebuild` generates, and :ios drives .github/workflows/ios-preview.yaml
# against the `ios/` project the same command generates for that platform.
# see docs/operations/preview-deployment.md for the stage-by-stage picture
# and the required secrets and variables each reads from the environment.
#
# both platforms also have a release lane set now. :android's
# `bundle_release`, `next_play_version_code`, and `publish_to_play` lanes
# drive .github/workflows/android-release.yaml, which builds a signed
# Android App Bundle and uploads it to Google Play's internal testing track
# — see docs/operations/google-play-release.md. :ios's `build_release`,
# `next_testflight_build_number`, and `publish_to_testflight` lanes drive
# .github/workflows/ios-release.yaml the same way, uploading a signed,
# App Store-exported IPA to Apple TestFlight — see
# docs/operations/ios-testflight-release.md. Neither release lane submits
# anything for store review or assigns it to testers; that stays a manual
# step a maintainer performs afterward in the respective console.

default_platform(:android)

# fastlane runs a lane's own Ruby (everything written directly in a `lane do`
# block below) with the working directory set to this file's own directory,
# `fastlane/` — but runs every *action* it calls (`gradle`, `build_app`,
# `update_code_signing_settings`, and so on) with the working directory set
# back to the repository root. fastlane's own docs state this plainly: "every
# action and every plugin's code runs in the root of the project, while all
# user code from the Fastfile runs inside the ./fastlane directory." so a
# repository-root-relative path such as `"android"` is correct as an *action
# parameter* (`gradle(project_dir: "android")` below resolves it from the
# root, which is what we want) but wrong as *lane-body* code — a bare
# `Dir.glob("ios/*.xcworkspace")` written directly in a lane looks in
# `fastlane/ios/`, which never exists, and silently finds nothing.
#
# this helper is how lane-body code reaches a generated native project
# without falling into that trap: `__dir__` resolves to the directory this
# file lives in on disk, which is immune to either `chdir`, so joining it
# with `..` always lands on the repository root regardless of which working
# directory the calling code is currently running under.
def generated_native_dir(platform)
  File.join(File.expand_path("..", __dir__), platform.to_s)
end

# the two resolvers below exist so that each platform's `build` lane and its
# `verify_paths` lane run the *same* lookup rather than two copies of it. a
# check that restated this logic instead of calling it would keep passing
# while someone reintroduced a bare `Dir.glob("ios/…")` inside `build`, which
# is exactly the bug these lanes were added to catch: break the lookup and
# both lanes break together. `merge-checks.yaml`'s `native_paths` job used to
# run both platforms' `verify_paths` lane on every pull request so CI noticed
# there rather than on a dispatch after merge; it was removed and nothing
# replaced it, so that guarantee now holds only when someone runs
# `bundle exec fastlane android verify_paths` and
# `bundle exec fastlane ios verify_paths` locally.
def resolved_android_project_dir
  android_dir = generated_native_dir(:android)
  unless Dir.exist?(android_dir)
    UI.user_error!("No generated android/ project found at #{android_dir} — run `expo prebuild --platform android` first")
  end

  android_dir
end

def resolved_ios_project_paths
  ios_dir = generated_native_dir(:ios)

  workspace_path = Dir.glob(File.join(ios_dir, "*.xcworkspace")).first
  UI.user_error!("No .xcworkspace found under #{ios_dir} — run `expo prebuild --platform ios` and `pod install` first") if workspace_path.nil?

  project_path = Dir.glob(File.join(ios_dir, "*.xcodeproj")).first
  UI.user_error!("No .xcodeproj found under #{ios_dir} — run `expo prebuild --platform ios` first") if project_path.nil?

  [workspace_path, project_path]
end

platform :android do
  desc "Assemble a signed release APK from the generated android/ project"
  lane :build do
    # `gradle`'s `project_dir:` is an action parameter, so fastlane resolves
    # it from the repository root before this lane body ever runs — see
    # `generated_native_dir` above for why that is a relative path here but
    # an absolute one in the ios build lane right below this platform block.
    resolved_android_project_dir

    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV.fetch("ANDROID_KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
      }
    )

    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    UI.user_error!("Gradle did not report an APK output path") if apk_path.nil?

    UI.success("Built release APK at #{apk_path}")
    write_github_output("apk-path", apk_path)
    apk_path
  end

  desc "Run the android build lane's own project-path lookup and report it, without building"
  lane :verify_paths do
    android_dir = resolved_android_project_dir

    UI.success("Resolved generated android/ project at #{android_dir}")
    android_dir
  end

  desc "Assemble a signed Android App Bundle (.aab) from the generated android/ project, for a Google Play release"
  lane :bundle_release do
    # same reasoning as the build lane's own call above.
    resolved_android_project_dir

    # signing is injected the same way the build lane above injects it —
    # this repository's existing release keystore, through the same four
    # Gradle properties — because Google Play App Signing needs an upload
    # key, and reusing the existing one means no new signing material was
    # introduced for this pipeline. only the Gradle task differs: `bundle`
    # produces the Android App Bundle Google Play requires for a new app,
    # where `assemble` above produces an APK.
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV.fetch("ANDROID_KEYSTORE_PATH"),
        "android.injected.signing.store.password" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
        "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
        "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
      }
    )

    aab_path = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.user_error!("Gradle did not report an Android App Bundle output path") if aab_path.nil?

    UI.success("Built release Android App Bundle at #{aab_path}")
    write_github_output("aab-path", aab_path)
    aab_path
  end

  desc "Read the highest version code Google Play's internal testing track holds, and return the next one"
  lane :next_play_version_code do
    # `google_play_track_version_codes` opens an edit session against the
    # app and closes it again to answer this; Play permits one open edit per
    # account, which is why android-release.yaml serialises release runs
    # rather than letting two overlap — see that workflow's own
    # `concurrency:` comment.
    version_codes = google_play_track_version_codes(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME"),
      track: "internal",
      json_key: ENV.fetch("PLAY_SERVICE_ACCOUNT_CREDENTIALS_PATH")
    )

    # the action returns `[]`, not an error, when the track has no release
    # yet — exactly the state this app is in before its first upload — so
    # falling back to 1 here is what makes that first upload possible at
    # all, rather than a defensive fallback for an error case.
    next_code = version_codes.empty? ? 1 : version_codes.max + 1

    # a version code is consumed permanently and Google Play refuses one
    # above this value for any app; failing here costs nothing, since this
    # lane has not written anything yet.
    UI.user_error!("Computed Google Play version code #{next_code} would exceed Google Play's maximum of 2,100,000,000") if next_code > 2_100_000_000

    UI.success("Next Google Play version code: #{next_code} (internal track currently reports #{version_codes.empty? ? "no release" : "a maximum of #{version_codes.max}"})")
    write_github_output("version-code", next_code)
    next_code
  end

  desc "Upload a release Android App Bundle to Google Play's internal testing track"
  lane :publish_to_play do |options|
    aab_path = options[:aab_path] || ENV["RELEASE_AAB_PATH"] || lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.user_error!("No Android App Bundle path given — run the bundle_release lane first or pass aab_path:") if aab_path.nil?

    upload_to_play_store(
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME"),
      track: "internal",
      aab: aab_path,
      json_key: ENV.fetch("PLAY_SERVICE_ACCOUNT_CREDENTIALS_PATH"),
      # available to internal testers immediately, with nothing left
      # waiting in the Console for a human to publish — see the plan this
      # lane implements (issue #120) for why this and the flag right below
      # it are spelled out rather than left to their defaults.
      release_status: "completed",
      # this is already upload_to_play_store's own default; it is written
      # out because the plan this lane implements treats it as a
      # considered choice; changing it would hold the release back from
      # testers until someone sends it for review by hand in the Console.
      changes_not_sent_for_review: false,
      # no release notes, no APK, and no mapping or native-debug-symbols
      # file are part of this change. `mapping`/`mapping_paths` are simply
      # omitted above — upload_to_play_store has no default path to fall
      # back to for either, so omitting them already skips them. the four
      # flags below have no such free lunch: each defaults to attempting an
      # upload from a conventional path (an auto-detected APK,
      # fastlane/metadata/android, its screenshots) that this repository
      # does not maintain, so leaving any of them at its default risks a
      # failure over a file that was never meant to exist yet, rather than
      # the deliberate skip this change calls for.
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Uploaded to Google Play's internal testing track: #{aab_path}")
    aab_path
  end

  desc "Distribute a release APK to Firebase App Distribution"
  lane :publish do |options|
    apk_path = options[:apk_path] || ENV["PREVIEW_APK_PATH"] || lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    UI.user_error!("No APK path given — run the build lane first or pass apk_path:") if apk_path.nil?

    tester_groups = ENV["FIREBASE_TESTER_GROUPS"]

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_ANDROID_APP_ID"),
      apk_path: apk_path,
      service_credentials_file: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_CREDENTIALS_PATH"),
      groups: tester_groups.nil? || tester_groups.empty? ? nil : tester_groups
    )

    # the action stores the uploaded release as a hash on this shared value —
    # it does not export a testing-URI value of its own. the hash's keys are
    # camelCase, mirroring the Firebase App Distribution API's own JSON
    # response shape: `release_hash = deep_symbolize_keys(JSON.parse(release.to_json))`
    # in fastlane-plugin-firebase_app_distribution 1.0.0's
    # firebase_app_distribution_action.rb (self.run, right before it sets this
    # shared value), and `release.to_json` follows the JSON property names
    # google-apis-firebaseappdistribution_v1 0.22.0 declares for the release
    # class in representations.rb — `property :testing_uri, as: 'testingUri'`,
    # plus `binaryDownloadUri` and `firebaseConsoleUri` for the two fallbacks
    # below. `deep_symbolize_keys` only symbolizes each JSON key verbatim, so
    # the hash carries `:testingUri`, not `:testing_uri`.
    #
    # prefer the tester-facing link. if a future plugin version renames or
    # drops that key, fall back to whatever other URI the release hash does
    # carry rather than failing a publish that actually succeeded — a stale
    # or missing link is only worse than none when nothing published at all.
    release = lane_context[SharedValues::FIREBASE_APP_DISTRO_RELEASE]
    testing_uri = release.is_a?(Hash) ? (release[:testingUri] || release[:binaryDownloadUri] || release[:firebaseConsoleUri]) : nil

    if testing_uri.nil?
      # name only the keys the release hash carried, never their values: this
      # hash's values are download links, which are capability URLs, so
      # printing one here would leak a credential-equivalent on a failure path.
      known_keys = release.is_a?(Hash) ? release.keys.join(", ") : "(none — no release hash was reported)"
      UI.user_error!("Firebase App Distribution did not report a usable testing or download URI. Release hash keys present: #{known_keys}")
    end

    UI.success("Published to Firebase App Distribution: #{testing_uri}")
    write_github_output("testing-uri", testing_uri)
    testing_uri
  end
end

platform :ios do
  desc "Assemble a signed ad-hoc IPA from the generated ios/ project"
  lane :build do
    workspace_path, project_path = resolved_ios_project_paths

    scheme = File.basename(workspace_path, ".xcworkspace")
    team_id = ENV.fetch("APPLE_DEVELOPER_TEAM_ID")
    bundle_identifier = ENV.fetch("APP_BUNDLE_IDENTIFIER")
    profile_name = ENV.fetch("PROVISIONING_PROFILE_NAME")

    # the generated Xcode project defaults to automatic signing; this
    # workflow provisions a single ad-hoc distribution certificate and
    # profile directly (see ios-preview.yaml's signing-setup steps) rather
    # than through `fastlane match`, so signing is switched to manual here
    # and pinned to exactly the certificate and profile that setup imported.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: bundle_identifier
    )

    build_app(
      workspace: workspace_path,
      scheme: scheme,
      export_method: "ad-hoc",
      export_team_id: team_id,
      # `method` is deliberately absent here — gym merges its own
      # `export_method:` parameter above into this hash, and setting the
      # same key in both places is a known source of mismatches between the
      # two (fastlane/fastlane#17231). `signingStyle` and
      # `provisioningProfiles` have no top-level gym equivalent, so they can
      # only be set here.
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_identifier => profile_name
        }
      }
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("build_app did not report an IPA output path") if ipa_path.nil?

    UI.success("Built ad-hoc IPA at #{ipa_path}")
    write_github_output("ipa-path", ipa_path)
    ipa_path
  end

  desc "Run the ios build lane's own workspace and project lookup and report them, without building"
  lane :verify_paths do
    workspace_path, project_path = resolved_ios_project_paths

    UI.success("Resolved workspace at #{workspace_path} and Xcode project at #{project_path}")
    [workspace_path, project_path]
  end

  desc "Assemble a signed, App Store-exported IPA from the generated ios/ project, for a TestFlight release"
  lane :build_release do
    workspace_path, project_path = resolved_ios_project_paths

    scheme = File.basename(workspace_path, ".xcworkspace")
    team_id = ENV.fetch("APPLE_DEVELOPER_TEAM_ID")
    bundle_identifier = ENV.fetch("APP_BUNDLE_IDENTIFIER")
    profile_name = ENV.fetch("PROVISIONING_PROFILE_NAME")

    # same reasoning as the :build lane above — manual signing, pinned to
    # exactly the certificate and profile ios-release.yaml's `build` job
    # imported. the certificate is the same "Apple Distribution" one that
    # lane already uses (Apple's unified certificate model covers both
    # ad-hoc and App Store distribution); only the provisioning profile
    # differs, since TestFlight requires an App Store profile rather than
    # an ad-hoc one.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: project_path,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: bundle_identifier
    )

    build_app(
      workspace: workspace_path,
      scheme: scheme,
      # "app-store", not the newer "app-store-connect" xcodebuild -help now
      # advertises: fastlane 2.238.0's gym action (this project's pinned
      # fastlane version, per Gemfile.lock) still validates export_method
      # against the legacy value set only — the same set the :build lane's
      # own "ad-hoc" already relies on — and rejects "app-store-connect"
      # before xcodebuild ever sees it. Verified against
      # gym/lib/gym/options.rb at that exact tag.
      export_method: "app-store",
      export_team_id: team_id,
      # `method` is deliberately absent here — same reasoning as the
      # :build lane above (fastlane/fastlane#17231).
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_identifier => profile_name
        }
      }
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("build_app did not report an IPA output path") if ipa_path.nil?

    UI.success("Built App Store IPA at #{ipa_path}")
    write_github_output("ipa-path", ipa_path)
    ipa_path
  end

  desc "Read the highest TestFlight build number App Store Connect reports for the current app version, and return the next one"
  lane :next_testflight_build_number do
    app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    )
    api_key = Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]

    app_version = ENV.fetch("APP_VERSION_NAME")

    # `latest_testflight_build_number` returns `initial_build_number`
    # unmodified when the queried version has no build yet — never "one
    # less than the caller would expect" — so `initial_build_number: 0`
    # here is what makes the `+ 1` below land on 1 for this app's very
    # first upload of a version, mirroring `next_play_version_code`'s own
    # empty-track fallback right above. Leaving the action's own default
    # (1) in place is a known source of confusion (fastlane/fastlane#19988)
    # precisely because it silently skips build number 1.
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_BUNDLE_IDENTIFIER"),
      version: app_version,
      initial_build_number: 0
    )

    next_build_number = latest_build_number + 1

    UI.success("Next TestFlight build number: #{next_build_number} (App Store Connect currently reports a maximum of #{latest_build_number} for version #{app_version})")
    write_github_output("build-number", next_build_number)
    next_build_number
  end

  desc "Upload a release IPA to TestFlight — no external distribution, no tester group assignment"
  lane :publish_to_testflight do |options|
    ipa_path = options[:ipa_path] || ENV["RELEASE_IPA_PATH"] || lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("No IPA path given — run the build_release lane first or pass ipa_path:") if ipa_path.nil?

    app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_PATH")
    )
    api_key = Actions.lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]

    upload_to_testflight(
      ipa: ipa_path,
      api_key: api_key,
      app_identifier: ENV.fetch("APP_BUNDLE_IDENTIFIER"),
      # `distribute_external` is left at its own default (false) and no
      # `groups:` is passed, so this upload lands in App Store Connect's
      # Builds list only — no Beta App Review submission, no tester group
      # assignment. This pipeline's scope ends here; promoting the build
      # further is a manual App Store Connect step a maintainer performs
      # afterward — see the plan this lane implements (issue #171).
      #
      # `skip_waiting_for_build_processing: true` is set primarily so this
      # job's own timeout is not sized to wait out Apple's build processing
      # (which can run well past an hour) — but it also reinforces the
      # paragraph above: pilot's own documentation states plainly that with
      # this set, "the `distribute_external` option won't work and no build
      # will be distributed to testers," regardless of how that option is
      # set. Verified against `fastlane action upload_to_testflight`'s own
      # output on this project's pinned fastlane version (2.238.0).
      skip_waiting_for_build_processing: true
    )

    UI.success("Uploaded to TestFlight: #{ipa_path}")
    ipa_path
  end

  desc "Distribute an ad-hoc IPA to Firebase App Distribution"
  lane :publish do |options|
    ipa_path = options[:ipa_path] || ENV["PREVIEW_IPA_PATH"] || lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("No IPA path given — run the build lane first or pass ipa_path:") if ipa_path.nil?

    tester_groups = ENV["FIREBASE_TESTER_GROUPS"]

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_IOS_APP_ID"),
      ipa_path: ipa_path,
      service_credentials_file: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_CREDENTIALS_PATH"),
      groups: tester_groups.nil? || tester_groups.empty? ? nil : tester_groups
    )

    # same shared value, same shape, same reasoning as the :android publish
    # lane above — see its comment for why the release hash's keys are
    # camelCase and why the fallback order is testingUri, then
    # binaryDownloadUri, then firebaseConsoleUri.
    release = lane_context[SharedValues::FIREBASE_APP_DISTRO_RELEASE]
    testing_uri = release.is_a?(Hash) ? (release[:testingUri] || release[:binaryDownloadUri] || release[:firebaseConsoleUri]) : nil

    if testing_uri.nil?
      # name only the keys the release hash carried, never their values: this
      # hash's values are download links, which are capability URLs, so
      # printing one here would leak a credential-equivalent on a failure path.
      known_keys = release.is_a?(Hash) ? release.keys.join(", ") : "(none — no release hash was reported)"
      UI.user_error!("Firebase App Distribution did not report a usable testing or download URI. Release hash keys present: #{known_keys}")
    end

    UI.success("Published to Firebase App Distribution: #{testing_uri}")
    write_github_output("testing-uri", testing_uri)
    testing_uri
  end

  desc "Export the UDIDs of testers registered with this app in Firebase App Distribution"
  lane :udids do |options|
    # a lane, not a workflow, on purpose: registering a UDID in the Apple
    # Developer portal and regenerating the ad-hoc provisioning profile
    # afterward are both manual, human steps regardless — automating only
    # the fetch half would add a workflow that still cannot finish the job.
    # run this from a maintainer's machine with FIREBASE_IOS_APP_ID and
    # either GOOGLE_APPLICATION_CREDENTIALS or service_credentials_file: set
    # to a Firebase service-account JSON key.
    output_file = options[:output_file] || "fastlane/firebase-tester-udids.csv"
    service_credentials_file = options[:service_credentials_file] || ENV["GOOGLE_APPLICATION_CREDENTIALS"]
    UI.user_error!("No Firebase service-account credentials given — pass service_credentials_file: or set GOOGLE_APPLICATION_CREDENTIALS") if service_credentials_file.nil?

    firebase_app_distribution_get_udids(
      app: ENV.fetch("FIREBASE_IOS_APP_ID"),
      service_credentials_file: service_credentials_file,
      output_file: output_file
    )

    UI.success("Wrote registered tester UDIDs to #{output_file}")
    output_file
  end
end

# appends `key=value` to $GITHUB_OUTPUT when running in GitHub Actions, so the
# workflow's next step can read the value with `steps.<id>.outputs.<key>`.
# a no-op outside CI, so every lane above stays runnable from a developer
# machine.
def write_github_output(key, value)
  output_file = ENV["GITHUB_OUTPUT"]
  return if output_file.nil?

  File.open(output_file, "a") { |file| file.puts("#{key}=#{value}") }
end
