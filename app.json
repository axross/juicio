{
  "expo": {
    "name": "juicio",
    "slug": "juicio",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "juicio",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios"],
    "ios": {
      "bundleIdentifier": "app.axross.juicio",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "app.axross.juicio",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@sentry/react-native/expo",
      "expo-localization",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      "./plugins/with-gradle-performance-properties",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/InnovatorGrotesk-Black.otf",
            "./assets/fonts/InnovatorGrotesk-BlackItalic.otf",
            "./assets/fonts/InnovatorGrotesk-Bold.otf",
            "./assets/fonts/InnovatorGrotesk-BoldItalic.otf",
            "./assets/fonts/InnovatorGrotesk-ExtraBold.otf",
            "./assets/fonts/InnovatorGrotesk-ExtraBoldItalic.otf",
            "./assets/fonts/InnovatorGrotesk-ExtraLight.otf",
            "./assets/fonts/InnovatorGrotesk-ExtraLightItalic.otf",
            "./assets/fonts/InnovatorGrotesk-Light.otf",
            "./assets/fonts/InnovatorGrotesk-LightItalic.otf",
            "./assets/fonts/InnovatorGrotesk-Medium.otf",
            "./assets/fonts/InnovatorGrotesk-MediumItalic.otf",
            "./assets/fonts/InnovatorGrotesk-Regular.otf",
            "./assets/fonts/InnovatorGrotesk-RegularItalic.otf",
            "./assets/fonts/InnovatorGrotesk-SemiBold.otf",
            "./assets/fonts/InnovatorGrotesk-SemiBoldItalic.otf",
            "./assets/fonts/InnovatorGrotesk-Thin.otf",
            "./assets/fonts/InnovatorGrotesk-ThinItalic.otf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
