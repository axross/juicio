#!/usr/bin/env bash
set -euo pipefail

step() {
  local label="$1"
  shift
  echo "==> ${label}"
  time "$@"
}

install_system_packages() {
  local packages=()
  local package
  for package in build-essential ca-certificates curl pkg-config unzip; do
    dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q 'install ok installed' || packages+=("$package")
  done

  if ((${#packages[@]})); then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
  fi
}

install_mise() (
  local version='2026.9.1'
  local expected_sha256='c98423c8470d6dc416d9f7036d0646d8ef5ae92ad9186907f8fcc84cbe7db4ea'
  local mise_path="$HOME/.local/bin/mise"
  local download

  if [[ -x "$mise_path" && "$($mise_path --version)" == "${version} "* ]]; then
    return
  fi

  download="$(mktemp)"
  trap 'rm -f -- "$download"' EXIT
  curl -fsSL \
    "https://github.com/jdx/mise/releases/download/v${version}/mise-v${version}-linux-x64" \
    -o "$download"
  printf '%s  %s\n' "$expected_sha256" "$download" | sha256sum --check --status
  install -m 0755 "$download" "$mise_path"
)

configure_toolchains() {
  mkdir -p "$HOME/.config/mise" "$HOME/.android-sdk"
  cat >"$MISE_GLOBAL_CONFIG_FILE" <<'EOF'
[tools]
node = "24"
npm = "11"
java = "temurin-17"
android-sdk = "23.0"
rust = { version = "stable", profile = "minimal", components = ["rustfmt", "clippy"] }

[env]
ANDROID_HOME = "{{env.HOME}}/.android-sdk"
ANDROID_SDK_ROOT = "{{env.HOME}}/.android-sdk"
_.path = ["{{env.HOME}}/.android-sdk/platform-tools"]
EOF

  "$HOME/.local/bin/mise" install --yes
}

persist_login_environment() {
  local marker='# juicio Amp orb toolchain'
  touch "$HOME/.bash_profile"
  if ! grep -Fqx "$marker" "$HOME/.bash_profile"; then
    cat >>"$HOME/.bash_profile" <<'EOF'

# juicio Amp orb toolchain
export MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/juicio.toml"
export PATH="$HOME/.local/bin:$PATH"
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi
EOF
  elif ! grep -Fqx 'export MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/juicio.toml"' "$HOME/.bash_profile"; then
    sed -i "/^# juicio Amp orb toolchain$/a export MISE_GLOBAL_CONFIG_FILE=\"\$HOME/.config/mise/juicio.toml\"" "$HOME/.bash_profile"
  fi
}

restore_javascript_dependencies() {
  local fingerprint marker
  fingerprint="$(sha256sum package-lock.json | cut -d' ' -f1)-node24"
  marker="node_modules/.juicio-npm-ci-${fingerprint}"
  if [[ ! -f "$marker" ]]; then
    npm ci
    rm -f node_modules/.juicio-npm-ci-*
    touch "$marker"
  else
    echo "package-lock.json is already restored; skipping npm ci"
  fi
  [[ -f .env.local ]] || cp -- .env.example .env.local
}

install_android_components() {
  local versions="$PWD/node_modules/react-native/gradle/libs.versions.toml"
  local compile_sdk build_tools ndk_version
  compile_sdk="$(sed -n 's/^compileSdk = "\([^"]*\)"/\1/p' "$versions")"
  build_tools="$(sed -n 's/^buildTools = "\([^"]*\)"/\1/p' "$versions")"
  ndk_version="$(sed -n 's/^ndkVersion = "\([^"]*\)"/\1/p' "$versions")"
  [[ -n "$compile_sdk" && -n "$build_tools" && -n "$ndk_version" ]] || {
    echo "Unable to resolve Android SDK versions from $versions" >&2
    return 1
  }

  set +o pipefail
  yes | sdkmanager --sdk_root="$ANDROID_HOME" --licenses >/dev/null
  local license_status="${PIPESTATUS[1]}"
  set -o pipefail
  ((license_status == 0)) || return "$license_status"

  sdkmanager --sdk_root="$ANDROID_HOME" \
    "platform-tools" "platforms;android-${compile_sdk}" \
    "build-tools;${build_tools}" "ndk;${ndk_version}"
}

verify_toolchains() {
  local versions="$PWD/node_modules/react-native/gradle/libs.versions.toml"
  local compile_sdk build_tools ndk_version
  compile_sdk="$(sed -n 's/^compileSdk = "\([^"]*\)"/\1/p' "$versions")"
  build_tools="$(sed -n 's/^buildTools = "\([^"]*\)"/\1/p' "$versions")"
  ndk_version="$(sed -n 's/^ndkVersion = "\([^"]*\)"/\1/p' "$versions")"

  [[ "$(node --version)" == v24.* ]]
  [[ "$(npm --version)" == 11.* ]]
  [[ "$(java -version 2>&1)" == *'version "17.'* ]]
  [[ "$(rustc --version)" == rustc* ]]
  for directory in \
    platform-tools \
    "platforms/android-${compile_sdk}" \
    "build-tools/${build_tools}" \
    "ndk/${ndk_version}"; do
    [[ -d "$ANDROID_HOME/$directory" ]] || {
      echo "Missing required Android SDK directory: $ANDROID_HOME/$directory" >&2
      return 1
    }
  done
}

mkdir -p "$HOME/.local/bin"
export MISE_GLOBAL_CONFIG_FILE="$HOME/.config/mise/juicio.toml"
step "Install required system packages" install_system_packages
step "Install mise" install_mise
step "Configure Node, Java, and Android SDK" configure_toolchains
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise env -s bash)"
step "Persist the toolchain for login shells" persist_login_environment
step "Restore locked JavaScript dependencies" restore_javascript_dependencies
step "Install locked React Native Android SDK components" install_android_components
step "Verify the provisioned toolchains" verify_toolchains
